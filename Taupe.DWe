local Theme = {
    Bg        = Color3.fromRGB(23, 23, 22),
    Side      = Color3.fromRGB(28, 28, 26),
    Panel     = Color3.fromRGB(32, 32, 30),
    Elem      = Color3.fromRGB(40, 39, 37),
    ElemHover = Color3.fromRGB(48, 47, 44),
    Stroke    = Color3.fromRGB(56, 55, 51),
    Text      = Color3.fromRGB(221, 217, 207),
    Sub       = Color3.fromRGB(138, 134, 124),
    Accent    = Color3.fromRGB(184, 172, 146),
    AccentDim = Color3.fromRGB(118, 110, 94),
    Off       = Color3.fromRGB(60, 59, 55),
    Good      = Color3.fromRGB(141, 153, 112),
    Bad       = Color3.fromRGB(184, 96, 76),
    -- ESP
    EspMon    = Color3.fromRGB(198, 94, 72),
    EspGen    = Color3.fromRGB(205, 182, 128),
    EspDone   = Color3.fromRGB(126, 146, 104),
    EspItem   = Color3.fromRGB(150, 172, 182),
    EspRare   = Color3.fromRGB(226, 196, 118),
    EspPlayer = Color3.fromRGB(172, 162, 198),
}
local FONT, FONT_M, FONT_B = Enum.Font.Gotham, Enum.Font.GothamMedium, Enum.Font.GothamBold

local function create(class, props)
    local parent = props.Parent
    props.Parent = nil
    local o = Instance.new(class)
    for k, v in pairs(props) do o[k] = v end
    if parent then o.Parent = parent end
    return o
end
local function corner(o, r) return create("UICorner", { CornerRadius = UDim.new(0, r or 6), Parent = o }) end
local function stroke(o, c, t)
    return create("UIStroke", { Color = c or Theme.Stroke, Thickness = t or 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = o })
end
local function pad(o, l, r, t, b)
    return create("UIPadding", { PaddingLeft = UDim.new(0, l), PaddingRight = UDim.new(0, r), PaddingTop = UDim.new(0, t), PaddingBottom = UDim.new(0, b), Parent = o })
end
local function tw(o, t, props)
    local x = TweenService:Create(o, TweenInfo.new(t, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), props)
    x:Play()
    return x
end


---------------------------------------------------------------------------
-- ESP
---------------------------------------------------------------------------
local ESP = { map = {}, tick = 0 }

local function espSet(inst, color, text, highlight)
    local e = ESP.map[inst]
    if not e then
        local adorn = partOf(inst)
        if not adorn then return end
        local bb = create("BillboardGui", {
            Adornee = adorn, Size = UDim2.fromOffset(220, 34), StudsOffset = Vector3.new(0, 3.2, 0),
            AlwaysOnTop = true, LightInfluence = 0, ResetOnSpawn = false, Parent = EspFolder,
        })
        local tl = create("TextLabel", {
            BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Font = FONT_M, TextSize = 12,
            TextStrokeTransparency = 0.45, TextStrokeColor3 = Color3.new(0, 0, 0), Text = "", Parent = bb,
        })
        e = { bb = bb, tl = tl }
        ESP.map[inst] = e
    end
    e.seen = ESP.tick
    e.tl.Text = text
    e.tl.TextColor3 = color
    if highlight and F.ESPHighlight then
        if not e.hl then
            e.hl = create("Highlight", {
                Adornee = inst, FillTransparency = 0.78, OutlineTransparency = 0.15,
                DepthMode = Enum.HighlightDepthMode.AlwaysOnTop, Parent = EspFolder,
            })
        end
        e.hl.FillColor = color
        e.hl.OutlineColor = color
    elseif e.hl then
        e.hl:Destroy()
        e.hl = nil
    end
end

local function distTxt(p, myPos)
    if not F.ESPDistance or not myPos or not p then return "" end
    return ("  ·  %d st"):format(floor((p - myPos).Magnitude))
end

local function espTick()
    ESP.tick = ESP.tick + 1
    local h = getHRP()
    local myPos = h and h.Position
    local function inRange(p) return p and (not myPos or (p - myPos).Magnitude <= F.ESPMaxDist) end
    if F.ESPTwisted then
        for _, m in ipairs(Cache.monsters) do
            local p = posOf(m)
            if inRange(p) then
                local tag = G.isMain(m) and " ★" or ""
                if G.isRanged(m) then tag = tag .. " ⟶" end
                espSet(m, Theme.EspMon, G.twName(m) .. tag .. distTxt(p, myPos), true)
            end
        end
    end
    if F.ESPGens then
        for _, g in ipairs(Cache.gens) do
            local p = posOf(g)
            if inRange(p) then
                local done = G.genDone(g)
                local prog = G.genProgress(g)
                local txt
                if done then txt = "Máquina ✓"
                else
                    txt = "Máquina " .. (prog and (floor(prog) .. "%") or "")
                    if F.ESPHeat and (Heat[g] or 0) >= 1 then txt = txt .. ("  calor %d"):format(floor(Heat[g])) end
                end
                espSet(g, done and Theme.EspDone or Theme.EspGen, txt .. distTxt(p, myPos), true)
            end
        end
    end
    if F.ESPItems then
        for _, it in ipairs(Cache.items) do
            local p = posOf(it)
            if inRange(p) then
                local rare = hasAny(it.Name, F.RareItems or {})
                espSet(it, rare and Theme.EspRare or Theme.EspItem, it.Name .. distTxt(p, myPos), false)
            end
        end
    end
    if F.ESPPlayers then
        for _, pl in ipairs(Players:GetPlayers()) do
            if pl ~= LP and pl.Character then
                local p = posOf(pl.Character)
                if inRange(p) then
                    local hp, mx = G.health(pl.Character)
                    local st, smx = G.stamina(pl)
                    local txt = pl.DisplayName
                    if hp then txt = txt .. ("  ♥ %s/%s"):format(floor(hp + 0.5), floor(mx + 0.5)) end
                    if st then txt = txt .. ("  ϟ %d%%"):format(floor(st / smx * 100)) end
                    espSet(pl.Character, Theme.EspPlayer, txt .. distTxt(p, myPos), true)
                end
            end
        end
    end
    for inst, e in pairs(ESP.map) do
        if e.seen ~= ESP.tick or not inst.Parent then
            pcall(function() e.bb:Destroy() end)
            if e.hl then pcall(function() e.hl:Destroy() end) end
            ESP.map[inst] = nil
        end
    end
end

---------------------------------------------------------------------------
-- Alertas
---------------------------------------------------------------------------
local Alert = { room = nil, seenMon = {}, seenItem = {}, ally = {}, floor = 0, selfHp = nil }

local function alertTick()
    if Cache.room ~= Alert.room then
        Alert.room = Cache.room
        Alert.seenMon, Alert.seenItem = {}, {}
        Heat = {}
        Farm.blacklist, Farm.itemBL = {}, {}
        if Cache.room then
            Alert.roomGrace = F.NotifyFloor and (tick() + 4) or 0
            Alert.floor = G.floorNumber() or (Alert.floor + 1)
            if F.NotifyFloor then
                local fl = Alert.floor
                task.delay(2.5, function()
                    local names = {}
                    for _, m in ipairs(Cache.monsters) do names[#names + 1] = G.twName(m) end
                    notify(("Piso %d"):format(fl), ("%d máquinas · %d ítems · %d twisteds%s"):format(
                        #Cache.gens, #Cache.items, #Cache.monsters, #names > 0 and ("\n" .. table.concat(names, ", ")) or ""), nil, 6)
                end)
            end
        end
    end
    if Cache.room then
        local new, anyMain = {}, false
        for _, m in ipairs(Cache.monsters) do
            if not Alert.seenMon[m] then
                Alert.seenMon[m] = true
                if tick() > (Alert.roomGrace or 0) then
                    new[#new + 1] = G.twName(m) .. (G.isRanged(m) and " (distancia)" or "")
                    if G.isMain(m) then anyMain = true end
                end
            end
        end
        if F.NotifyTwisted and #new > 0 then
            notify(anyMain and "Twisted principal" or "Twisted", table.concat(new, ", "), anyMain and "bad" or nil)
        end
        for _, it in ipairs(Cache.items) do
            if not Alert.seenItem[it] then
                Alert.seenItem[it] = true
                if F.NotifyItems and hasAny(it.Name, F.RareItems or {}) then notify("Ítem raro", it.Name, "good") end
            end
        end
    end
    -- equipo
    local now = tick()
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl ~= LP and pl.Character then
            local a = Alert.ally[pl] or {}
            Alert.ally[pl] = a
            local hp, mx = G.health(pl.Character)
            if hp then
                if a.hp and hp < a.hp - 0.01 and hp > 0 and F.NotifyAllyHurt then
                    notify("Aliado golpeado", ("%s · %s/%s"):format(pl.DisplayName, floor(hp + 0.5), floor(mx + 0.5)), "bad")
                end
                a.hp = hp
            end
            local st, smx = G.stamina(pl)
            if st and F.NotifyAllyStamina then
                local pct = st / smx * 100
                if pct <= F.StaminaThreshold and (not a.lowT or now - a.lowT > 20) then
                    a.lowT = now
                    notify("Stamina baja", ("%s · %d%%"):format(pl.DisplayName, floor(pct)))
                end
            end
        end
    end
    for pl in pairs(Alert.ally) do if not pl.Parent then Alert.ally[pl] = nil end end
end

---------------------------------------------------------------------------
-- Auto-heal / Veemote / Ability / Buy / Aura / Queue
---------------------------------------------------------------------------
local Heal = { last = nil, pending = nil, lastUse = 0 }
local HEAL_SMALL = { "bandage" }
local HEAL_BIG = { "healthkit", "medkit", "firstaid", "health" }

local function healTick()
    local hp, mx = G.health(LP.Character)
    if not hp then Heal.last = nil return end
    if Heal.last and hp < Heal.last - 0.01 and hp > 0 then
        if F.NotifySelfHurt then notify("Te golpearon", ("Vida: %s/%s"):format(floor(hp + 0.5), floor(mx + 0.5)), "bad", 3) end
        Heal.pending = tick() + F.HealDelay
    end
    Heal.last = hp
    if not F.AutoHeal or not Heal.pending or tick() < Heal.pending or tick() - Heal.lastUse < 1.2 then return end
    Heal.pending = nil
    if hp <= 0 or hp >= mx or (hp / mx * 100) > F.HealThreshold then return end
    local small, big = G.findItem(HEAL_SMALL), G.findItem(HEAL_BIG)
    local item
    if F.HealPriority == "Bandage primero" then item = small or big
    elseif F.HealPriority == "Healthkit primero" then item = big or small
    else
        local missing = mx - hp
        if missing >= mx * 0.5 then item = big or small else item = small or big end
    end
    item = item or G.findItem({ "heal", "chocolate" })
    if item and G.useItem(item) then
        Heal.lastUse = tick()
        notify("Auto-heal", "Usado: " .. item.name, "good", 3)
    end
end

local function heatTick()
    for _, g in ipairs(Cache.gens) do
        local gp = posOf(g)
        local n = 0
        if gp then
            for _, m in ipairs(Cache.monsters) do
                local mp = posOf(m)
                if mp and (mp - gp).Magnitude < F.HeatRadius then n = n + 1 end
            end
        end
        Heat[g] = (Heat[g] or 0) * 0.985 + n * 0.5
    end
    if not F.SmartVeemote or Vee.busy or tick() - Vee.last < F.VeemoteCooldown then return end
    local item = G.findItem({ "veemote" })
    if not item then return end
    local best, bh
    for _, g in ipairs(Cache.gens) do
        if not G.genDone(g) and (Heat[g] or 0) >= F.VeemoteMinHeat and (not bh or Heat[g] > bh) then best, bh = g, Heat[g] end
    end
    if not best then return end
    Vee.last = tick()
    Vee.busy = true
    task.spawn(function()
        local gp = posOf(best)
        if F.VeemoteMode == "Ir bajo la máquina" then
            local h = getHRP()
            local cf = workCF(best)
            if h and cf then
                local under = CFrame.new(cf.Position.X, groundY(cf.Position) + 3.2 - math.max(F.FarmDepth, 7), cf.Position.Z)
                Move.go(buildPath(h.Position, under, "Abajo"), F.TweenSpeed * 1.4, "veemote")
                local t0 = tick()
                while Hub.Alive and not Move.arrived and tick() - t0 < 6 do task.wait(0.05) end
            end
        end
        local cam = workspace.CurrentCamera
        if gp then cam.CFrame = CFrame.lookAt(cam.CFrame.Position, gp) end
        G.useItem(item)
        notify("Smart Veemote", ("Usado en la máquina con calor %d"):format(floor(bh)), "good")
        task.wait(0.4)
        if Move.owner == "veemote" then Move.stop(not F.AutoFarm) end
        Vee.busy = false
    end)
end

local Ability = { last = 0 }
local function abilityTick()
    if not (F.AutoAbility or F.MasteryFarm) then return end
    if tick() - Ability.last < F.AbilityInterval then return end
    local hum = getHum()
    if not hum or hum.Health <= 0 then return end
    local go = false
    if F.AbilityMode == "Siempre" then go = Cache.room ~= nil
    elseif F.AbilityMode == "Al reparar" then go = Farm.phase == "work"
    else
        local h = getHRP()
        local _, d = G.nearestMonster(h and h.Position)
        go = d ~= nil and d < F.DangerRadius
    end
    if go then
        Ability.last = tick()
        pressKey(keyFromName(F.AbilityKey))
    end
end

local Buy = { counts = {}, wasOpen = false, lastT = 0 }
local CONFIRM_K = { "buy", "purchase", "comprar", "confirm" }
local function findShop()
    local pg = LP:FindFirstChildOfClass("PlayerGui")
    if not pg then return nil end
    for _, d in ipairs(pg:GetDescendants()) do
        if d:IsA("GuiObject") and lower(d.Name):find("shop") and isShown(d) then return d end
    end
    return nil
end
local function btnMatches(b, item)
    if hasAny(b.Name, { item }) then return true end
    if b:IsA("TextButton") and hasAny(b.Text, { item }) then return true end
    for _, d in ipairs(b:GetDescendants()) do
        if d:IsA("TextLabel") and hasAny(d.Text, { item }) then return true end
    end
    local p = b.Parent
    if p and p:IsA("GuiObject") then
        if hasAny(p.Name, { item }) then return true end
        for _, d in ipairs(p:GetChildren()) do
            if d:IsA("TextLabel") and hasAny(d.Text, { item }) then return true end
        end
    end
    return false
end
local function buyTick()
    if not F.AutoBuy then return end
    if tick() - Buy.lastT < 0.6 then return end
    local shop = findShop()
    if not shop then Buy.wasOpen = false return end
    if not Buy.wasOpen then Buy.counts = {} Buy.wasOpen = true end
    Buy.lastT = tick()
    for _, item in ipairs(F.BuyList or {}) do
        if (Buy.counts[item] or 0) < F.BuyAmount then
            if F.BuyRemote then
                for _, d in ipairs(ReplicatedStorage:GetDescendants()) do
                    if d:IsA("RemoteEvent") or d:IsA("RemoteFunction") then
                        local n = lower(d.Name)
                        if n:find("buy") or n:find("purchase") then
                            pcall(function()
                                if d:IsA("RemoteEvent") then d:FireServer(item) else d:InvokeServer(item) end
                            end)
                        end
                    end
                end
                Buy.counts[item] = (Buy.counts[item] or 0) + 1
                return
            end
            for _, b in ipairs(shop:GetDescendants()) do
                if b:IsA("GuiButton") and isShown(b) and btnMatches(b, item) then
                    clickGui(b)
                    task.delay(0.15, function()
                        for _, c in ipairs(shop:GetDescendants()) do
                            if c:IsA("GuiButton") and isShown(c) and (hasAny(c.Name, CONFIRM_K) or (c:IsA("TextButton") and hasAny(c.Text, CONFIRM_K))) then
                                clickGui(c)
                                break
                            end
                        end
                    end)
                    Buy.counts[item] = (Buy.counts[item] or 0) + 1
                    notify("Auto-buy", "Comprando: " .. item, "good", 2.5)
                    return
                end
            end
        end
    end
end

local Aura = { cd = {} }
local function auraTick()
    if not F.ItemAura then return end
    local h = getHRP()
    if not h then return end
    for _, it in ipairs(Cache.items) do
        local p = posOf(it)
        if p and (p - h.Position).Magnitude <= F.AuraRadius and (Aura.cd[it] or 0) < tick() then
            Aura.cd[it] = tick() + 1.5
            collectItem(it)
        end
    end
end

local Queue = { lastT = 0 }
local function queueTick()
    if not F.AutoQueue or Cache.room then return end
    if tick() - Queue.lastT < 15 or Move.active then return end
    local h = getHRP()
    if not h then return end
    Queue.lastT = tick()
    local best, bd
    for _, d in ipairs(workspace:GetDescendants()) do
        if d:IsA("BasePart") then
            local n = lower(d.Name)
            local pn = d.Parent and lower(d.Parent.Name) or ""
            if (pn:find("elevator") or n:find("elevator")) and (n:find("zone") or n:find("inside") or n:find("hitbox") or n:find("enter") or n:find("trigger")) then
                local dd = (d.Position - h.Position).Magnitude
                if not bd or dd < bd then best, bd = d, dd end
            end
        end
    end
    if best then
        notify("Auto-queue", "Entrando al elevador…")
        teleportTo(best.Position, true)
    end
end

---------------------------------------------------------------------------
-- Bucles de física (Heartbeat / Stepped / RenderStepped)
---------------------------------------------------------------------------
local NC = { saved = {}, on = false }
bind(RunService.Stepped, function()
    local want = F.Noclip or F.Fly or Move.active
    local ch = LP.Character
    if want and ch then
        for _, p in ipairs(ch:GetDescendants()) do
            if p:IsA("BasePart") and p.CanCollide then
                NC.saved[p] = true
                p.CanCollide = false
            end
        end
        NC.on = true
    elseif NC.on then
        for p in pairs(NC.saved) do if p.Parent then p.CanCollide = true end end
        NC.saved = {}
        NC.on = false
    end
end)

local SB = { base = nil, lastSet = nil }
bind(RunService.Heartbeat, function(dt)
    local h, hum = getHRP(), getHum()
    if not h or not hum then return end

    -- Movimiento automatizado
    if Move.active and Move.path then
        local goal = Move.path[Move.i]
        if goal then
            local cur = h.Position
            local gp = goal.Position
            local delta = gp - cur
            local dist = delta.Magnitude
            local step = Move.speed * dt
            local newPos
            if dist <= step or dist < 0.05 then
                newPos = gp
                if Move.i < #Move.path then Move.i = Move.i + 1 else Move.arrived = true end
            else
                newPos = cur + delta.Unit * step
            end
            h.CFrame = CFrame.new(newPos) * (goal - goal.Position)
            h.AssemblyLinearVelocity = Vector3.zero
            h.AssemblyAngularVelocity = Vector3.zero
        end
        return
    end

    -- Fly
    if F.Fly then
        local cam = workspace.CurrentCamera
        local dir = Vector3.zero
        if UserInputService:GetFocusedTextBox() == nil then
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir = dir + cam.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir = dir - cam.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir = dir - cam.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir = dir + cam.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.yAxis end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then dir = dir - Vector3.yAxis end
        end
        if dir.Magnitude < 0.01 and hum.MoveDirection.Magnitude > 0 then dir = hum.MoveDirection end
        if dir.Magnitude > 0 then dir = dir.Unit end
        local look = cam.CFrame.LookVector
        local flat = Vector3.new(look.X, 0, look.Z)
        local pos = h.Position + dir * F.FlySpeed * dt
        h.CFrame = flat.Magnitude > 0.01 and CFrame.lookAt(pos, pos + flat) or CFrame.new(pos)
        h.AssemblyLinearVelocity = Vector3.zero
        return
    end

    -- TP walk
    if F.TPWalk and hum.MoveDirection.Magnitude > 0 then
        h.CFrame = h.CFrame + hum.MoveDirection * F.TPWalkSpeed * dt
    end

    -- WalkSpeed / Speed boost
    if F.WalkSpeedOn then
        if hum.WalkSpeed ~= F.WalkSpeed then hum.WalkSpeed = F.WalkSpeed end
        SB.lastSet = nil
    elseif F.SpeedBoost then
        local ws = hum.WalkSpeed
        if not SB.lastSet or abs(ws - SB.lastSet) > 0.01 then SB.base = ws end
        SB.lastSet = (SB.base or ws) * F.SpeedMult
        hum.WalkSpeed = SB.lastSet
    elseif SB.lastSet then
        if SB.base then hum.WalkSpeed = SB.base end
        SB.lastSet, SB.base = nil, nil
    end

    -- Stamina infinita (cliente)
    if F.InfStamina then
        local c = LP.Character
        for _, root in ipairs({ c, c and c:FindFirstChild("Stats"), LP, LP:FindFirstChild("Stats") }) do
            if root then
                local mx = root:GetAttribute("MaxStamina")
                if root:GetAttribute("Stamina") ~= nil then root:SetAttribute("Stamina", mx or 100) end
                local v = root:FindFirstChild("Stamina")
                if v and v:IsA("ValueBase") then
                    local mv = root:FindFirstChild("MaxStamina")
                    pcall(function() v.Value = (mv and mv.Value) or mx or 100 end)
                end
            end
        end
    end
end)

bind(RunService.RenderStepped, function(dt)
    if F.FOVOn then workspace.CurrentCamera.FieldOfView = F.FOV end
    local ok, err = pcall(scStep, dt)
    if not ok and F.Debug then warn("[TAUPE] skillcheck:", err) end
end)

---------------------------------------------------------------------------
-- Entrada (teclas)
---------------------------------------------------------------------------
bind(UserInputService.InputBegan, function(i, gp)
    if Lib.Binding then return end
    if i.UserInputType == Enum.UserInputType.Keyboard then
        if i.KeyCode.Name == F.ToggleKey and not gp then
            Main.Visible = not Main.Visible
        elseif i.KeyCode.Name == F.PanicKey and not gp then
            panic()
        end
    elseif i.UserInputType == Enum.UserInputType.MouseButton1 and F.ClickTP and UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
        local h = getHRP()
        local m = LP:GetMouse()
        if h and m.Hit then h.CFrame = CFrame.new(m.Hit.Position + Vector3.new(0, 3.2, 0)) end
    end
end)

bind(LP.Idled, function()
    if F.AntiAFK then
        pcall(function()
            VirtualUser:CaptureController()
            VirtualUser:ClickButton2(Vector2.new())
        end)
    end
end)

bind(LP.CharacterAdded, function()
    Move.stop(false)
    farmReset()
    Hide.target, Hide.origin, Hide.returning = nil, nil, false
    Heal.last = nil
    NC.saved, NC.on = {}, false
    SB.base, SB.lastSet = nil, nil
end)

-- Botón flotante para móvil
if UserInputService.TouchEnabled then
    local mb = create("TextButton", {
        Text = "T", Font = FONT_B, TextSize = 16, TextColor3 = Theme.Accent, AutoButtonColor = false,
        BackgroundColor3 = Theme.Panel, Size = UDim2.fromOffset(40, 40), Position = UDim2.new(0, 14, 0.4, 0), Parent = Gui,
    })
    corner(mb, 8)
    stroke(mb)
    local dragging, moved, sp, si = false, false, nil, nil
    mb.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging, moved, sp, si = true, false, mb.Position, i.Position
        end
    end)
    bind(UserInputService.InputChanged, function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseMovement) then
            local d = i.Position - si
            if d.Magnitude > 6 then moved = true end
            mb.Position = UDim2.new(sp.X.Scale, sp.X.Offset + d.X, sp.Y.Scale, sp.Y.Offset + d.Y)
        end
    end)
    mb.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
            if not moved then Main.Visible = not Main.Visible end
        end
    end)
end

---------------------------------------------------------------------------
-- Bucles lógicos
---------------------------------------------------------------------------
local function loop(interval, name, fn)
    task.spawn(function()
        while Hub.Alive do
            local ok, err = pcall(fn)
            if not ok and F.Debug then warn("[TAUPE] " .. name .. ":", err) end
            task.wait(interval)
        end
    end)
end

loop(0.35, "cache", G.refresh)
loop(0.15, "esp", espTick)
loop(0.5, "alert", alertTick)
loop(0.15, "heal", healTick)
loop(0.5, "heat", heatTick)
loop(0.25, "ability", abilityTick)
loop(0.2, "buy", buyTick)
loop(0.25, "aura", auraTick)
loop(1, "queue", queueTick)
loop(0.5, "light", function() if F.Fullbright or F.NoFog or LightSave then applyLighting() end end)

do
    local last = tick()
    loop(0.05, "brain", function()
        local now = tick()
        local dt = now - last
        last = now
        brainTick(dt)
    end)
end

loop(0.4, "status", function()
    local h = getHRP()
    local done = 0
    for _, g in ipairs(Cache.gens) do if G.genDone(g) then done = done + 1 end end
    local state = F.AutoFarm and Farm.status
        or (Hide.target and "Escondido")
        or (Move.owner == "distract" and "Distrayendo")
        or "Inactivo"
    stState:Set(state)
    stFloor:Set(Cache.room and tostring(Alert.floor) or "Lobby")
    stGens:Set(#Cache.gens > 0 and ("%d / %d"):format(done, #Cache.gens) or "—")
    stMons:Set(#Cache.monsters)
    local m, d = G.nearestMonster(h and h.Position)
    stNear:Set(m and ("%s · %d st"):format(G.twName(m), floor(d)) or "—")
    local hp, mx = G.health(LP.Character)
    local st, smx = G.stamina(LP)
    stHP:Set(("%s  ·  %s"):format(hp and (floor(hp + 0.5) .. "/" .. floor(mx + 0.5)) or "?", st and (floor(st / smx * 100) .. "%") or "?"))
    local names = {}
    for _, e in ipairs(G.inventory()) do names[#names + 1] = e.name end
    stInv:Set(#names > 0 and table.concat(names, ", ") or "vacío")
    TopStatus.Text = state .. (Cache.room and ("  ·  piso " .. Alert.floor) or "")
end)

---------------------------------------------------------------------------
-- Descarga
---------------------------------------------------------------------------
function Hub.Unload()
    if not Hub.Alive then return end
    Hub.Alive = false
    Move.stop(true)
    for _, c in ipairs(Conns) do pcall(function() c:Disconnect() end) end
    for p in pairs(NC.saved) do pcall(function() if p.Parent then p.CanCollide = true end end) end
    F.Fullbright, F.NoFog = false, false
    pcall(applyLighting)
    if SC.hooked and SC.oldNC and X.hookmm then pcall(function() X.hookmm(game, "__namecall", SC.oldNC) end) end
    pcall(function() Gui:Destroy() end)
    pcall(function() EspFolder:Destroy() end)
    if ENV.TaupeHub == Hub then ENV.TaupeHub = nil end
end


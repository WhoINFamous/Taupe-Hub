---------------------------------------------------------------------------
-- Utilidades
---------------------------------------------------------------------------
local function norm(s) return (lower(tostring(s)):gsub("[^%w]", "")) end

local function hasAny(name, list)
    local n = norm(name)
    for _, k in ipairs(list) do
        local nk = norm(k)
        if nk ~= "" and n:find(nk, 1, true) then return true end
    end
    return false
end

local function splitList(s)
    local t = {}
    for part in tostring(s):gmatch("[^,]+") do
        local p = part:gsub("^%s+", ""):gsub("%s+$", "")
        if p ~= "" then t[#t + 1] = p end
    end
    return t
end

local function getChar() return LP.Character end
local function getHRP() local c = LP.Character return c and c:FindFirstChild("HumanoidRootPart") end
local function getHum() local c = LP.Character return c and c:FindFirstChildOfClass("Humanoid") end

local function partOf(inst)
    if not inst then return nil end
    if inst:IsA("BasePart") then return inst end
    if inst:IsA("Model") then
        return inst.PrimaryPart or inst:FindFirstChild("HumanoidRootPart") or inst:FindFirstChildWhichIsA("BasePart", true)
    end
    return inst:FindFirstChildWhichIsA("BasePart", true)
end

local function posOf(inst)
    if not inst then return nil end
    if inst:IsA("BasePart") then return inst.Position end
    if inst:IsA("Model") then
        local p = inst.PrimaryPart or inst:FindFirstChild("HumanoidRootPart")
        if p then return p.Position end
        local ok, cf = pcall(inst.GetPivot, inst)
        if ok and cf then return cf.Position end
    end
    local p = inst:FindFirstChildWhichIsA("BasePart", true)
    return p and p.Position
end

-- Busca un valor por nombre en atributos / ValueBase dentro de las raíces dadas
local function findVal(roots, names)
    for _, root in ipairs(roots) do
        if root then
            for _, n in ipairs(names) do
                local a = root:GetAttribute(n)
                if a ~= nil then return a end
                local v = root:FindFirstChild(n)
                if v and v:IsA("ValueBase") then return v.Value end
            end
        end
    end
    return nil
end

local function statRoots(inst)
    if not inst then return {} end
    return { inst, inst:FindFirstChild("Stats"), inst:FindFirstChild("Values"), inst:FindFirstChild("Data") }
end

local SLOT_KEYS = {
    Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three, Enum.KeyCode.Four,
    Enum.KeyCode.Five, Enum.KeyCode.Six, Enum.KeyCode.Seven, Enum.KeyCode.Eight,
}

local function keyFromName(name)
    local ok, kc = pcall(function() return Enum.KeyCode[name] end)
    return ok and kc or nil
end

local function pressKey(kc)
    if not VIM or not kc then return end
    task.spawn(function()
        pcall(function() VIM:SendKeyEvent(true, kc, false, game) end)
        task.wait(0.03)
        pcall(function() VIM:SendKeyEvent(false, kc, false, game) end)
    end)
end

local function clickAt(x, y)
    if not VIM then return end
    pcall(function()
        VIM:SendMouseButtonEvent(x, y, 0, true, game, 0)
        VIM:SendMouseButtonEvent(x, y, 0, false, game, 0)
    end)
end

local function clickGui(b)
    if X.getconnections then
        for _, sn in ipairs({ "Activated", "MouseButton1Click", "MouseButton1Down", "MouseButton1Up" }) do
            local ok, cs = pcall(function() return X.getconnections(b[sn]) end)
            if ok and cs and #cs > 0 then
                for _, c in ipairs(cs) do pcall(function() c:Fire() end) end
                return true
            end
        end
    end
    if X.firesignal and pcall(X.firesignal, b.MouseButton1Click) then return true end
    local inset = GuiService:GetGuiInset()
    local p = b.AbsolutePosition + b.AbsoluteSize / 2 + inset
    clickAt(p.X, p.Y)
    return true
end

local function usePrompt(pr)
    if not pr then return end
    task.spawn(function()
        if X.fireprompt then
            local ok = pcall(X.fireprompt, pr)
            if ok then return end
        end
        pcall(function()
            pr:InputHoldBegin()
            task.wait((pr.HoldDuration or 0) + 0.06)
            pr:InputHoldEnd()
        end)
    end)
end

local function isShown(g)
    local x = g
    while x and x:IsA("GuiObject") do
        if not x.Visible then return false end
        x = x.Parent
    end
    if x and x:IsA("LayerCollector") then return x.Enabled end
    return x ~= nil
end


pad(SideList, 8, 8, 10, 8)
create("UIListLayout", { Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder, Parent = SideList })
create("TextLabel", {
    Text = "RightShift · ocultar", Font = FONT, TextSize = 11, TextColor3 = Theme.Off, BackgroundTransparency = 1,
    Position = UDim2.new(0, 14, 1, -26), Size = UDim2.new(1, -20, 0, 18), TextXAlignment = Enum.TextXAlignment.Left, Parent = Side,
})

local Content = create("Frame", {
    Position = UDim2.fromOffset(152, 38), Size = UDim2.new(1, -152, 1, -38), BackgroundTransparency = 1, Parent = Main,
})

-- Arrastrar ventana
do
    local dragging, startPos, startInput
    Top.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging, startPos, startInput = true, Main.Position, i.Position
        end
    end)
    bind(UserInputService.InputChanged, function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            local d = i.Position - startInput
            Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)
    bind(UserInputService.InputEnded, function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = false end
    end)
end

local minimized = false
MinBtn.MouseButton1Click:Connect(function()
    minimized = not minimized
    tw(Main, 0.3, { Size = minimized and UDim2.fromOffset(640, 38) or UDim2.fromOffset(640, 430) })
end)
CloseBtn.MouseButton1Click:Connect(function()
    Main.Visible = false
    notify("Interfaz oculta", "Pulsa " .. tostring(F.ToggleKey) .. " para volver a mostrarla.")
end)

local function hover(o, base, over)
    o.MouseEnter:Connect(function() tw(o, 0.15, { BackgroundColor3 = over or Theme.ElemHover }) end)
    o.MouseLeave:Connect(function() tw(o, 0.15, { BackgroundColor3 = base or Theme.Elem }) end)
end

local Section = {}
Section.__index = Section
local TabMT = {}
TabMT.__index = TabMT

function Lib:Select(tab)
    for _, t in ipairs(self.Tabs) do
        local on = (t == tab)
        t.page.Visible = on
        tw(t.btn, 0.18, { BackgroundTransparency = on and 0 or 1 })
        tw(t.ind, 0.18, { BackgroundTransparency = on and 0 or 1 })
        tw(t.lbl, 0.18, { TextColor3 = on and Theme.Text or Theme.Sub })
    end
    self.Current = tab
end

function Lib:Tab(name)
    local btn = create("TextButton", {
        Text = "", AutoButtonColor = false, Size = UDim2.new(1, 0, 0, 30), BackgroundColor3 = Theme.Elem,
        BackgroundTransparency = 1, LayoutOrder = #self.Tabs + 1, Parent = SideList,
    })
    corner(btn, 5)
    local ind = create("Frame", {
        Size = UDim2.fromOffset(3, 14), Position = UDim2.new(0, 0, 0.5, -7), BackgroundColor3 = Theme.Accent,
        BackgroundTransparency = 1, BorderSizePixel = 0, Parent = btn,
    })
    corner(ind, 2)
    local lbl = create("TextLabel", {
        Text = name, Font = FONT_M, TextSize = 13, TextColor3 = Theme.Sub, BackgroundTransparency = 1,
        Position = UDim2.fromOffset(14, 0), Size = UDim2.new(1, -14, 1, 0), TextXAlignment = Enum.TextXAlignment.Left, Parent = btn,
    })
    local page = create("ScrollingFrame", {
        Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3,
        ScrollBarImageColor3 = Theme.Stroke, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Visible = false, Parent = Content,
    })
    pad(page, 10, 12, 10, 12)
    local function col(x)
        local c = create("Frame", {
            BackgroundTransparency = 1, Size = UDim2.new(0.5, -5, 0, 0), Position = x,
            AutomaticSize = Enum.AutomaticSize.Y, Parent = page,
        })
        create("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = c })
        return c
    end
    local tab = setmetatable({ btn = btn, ind = ind, lbl = lbl, page = page, left = col(UDim2.new()), right = col(UDim2.new(0.5, 5, 0, 0)) }, TabMT)
    btn.MouseButton1Click:Connect(function() Lib:Select(tab) end)
    btn.MouseEnter:Connect(function() if Lib.Current ~= tab then tw(btn, 0.15, { BackgroundTransparency = 0.5 }) end end)
    btn.MouseLeave:Connect(function() if Lib.Current ~= tab then tw(btn, 0.15, { BackgroundTransparency = 1 }) end end)
    table.insert(self.Tabs, tab)
    if not self.Current then self:Select(tab) end
    return tab
end

function TabMT:Section(name, side)
    local colF = (side == "right") and self.right or self.left
    local s = create("Frame", {
        Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = Theme.Panel,
        BorderSizePixel = 0, LayoutOrder = #colF:GetChildren(), Parent = colF,
    })
    corner(s, 6)
    stroke(s)
    pad(s, 9, 9, 8, 9)
    create("UIListLayout", { Padding = UDim.new(0, 5), SortOrder = Enum.SortOrder.LayoutOrder, Parent = s })
    create("TextLabel", {
        Text = string.upper(name), Font = FONT_B, TextSize = 11, TextColor3 = Theme.Sub, BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 16), TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = 0, Parent = s,
    })
    return setmetatable({ frame = s, n = 0 }, Section)
end

function Section:_o() self.n = self.n + 1 return self.n end

function Section:Toggle(o)
    local h = o.Desc and 40 or 28
    local b = create("TextButton", {
        Text = "", AutoButtonColor = false, Size = UDim2.new(1, 0, 0, h), BackgroundColor3 = Theme.Elem,
        BorderSizePixel = 0, LayoutOrder = self:_o(), Parent = self.frame,
    })
    corner(b, 5)
    hover(b)
    create("TextLabel", {
        Text = o.Name, Font = FONT, TextSize = 13, TextColor3 = Theme.Text, BackgroundTransparency = 1,
        Position = UDim2.fromOffset(10, o.Desc and 4 or 0), Size = UDim2.new(1, -56, 0, o.Desc and 18 or h),
        TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = b,
    })
    if o.Desc then
        create("TextLabel", {
            Text = o.Desc, Font = FONT, TextSize = 11, TextColor3 = Theme.Sub, BackgroundTransparency = 1,
            Position = UDim2.fromOffset(10, 21), Size = UDim2.new(1, -56, 0, 15),
            TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = b,
        })
    end
    local track = create("Frame", {
        Size = UDim2.fromOffset(32, 16), Position = UDim2.new(1, -42, 0.5, -8), BackgroundColor3 = Theme.Off,
        BorderSizePixel = 0, Parent = b,
    })
    corner(track, 8)
    local knob = create("Frame", {
        Size = UDim2.fromOffset(12, 12), Position = UDim2.fromOffset(2, 2), BackgroundColor3 = Theme.Sub,
        BorderSizePixel = 0, Parent = track,
    })
    corner(knob, 6)
    local el = { value = false }
    function el:Set(v, silent)
        v = v and true or false
        el.value = v
        F[o.Flag] = v
        tw(track, 0.18, { BackgroundColor3 = v and Theme.AccentDim or Theme.Off })
        tw(knob, 0.18, { Position = v and UDim2.fromOffset(18, 2) or UDim2.fromOffset(2, 2), BackgroundColor3 = v and Theme.Text or Theme.Sub })
        if o.Callback and not silent then task.spawn(o.Callback, v) end
    end
    function el:Get() return el.value end
    b.MouseButton1Click:Connect(function() el:Set(not el.value) end)
    el:Set(F[o.Flag], true)
    Lib.Elements[o.Flag] = el
    return el
end

function Section:Slider(o)
    local f = create("Frame", {
        Size = UDim2.new(1, 0, 0, 42), BackgroundColor3 = Theme.Elem, BorderSizePixel = 0,
        LayoutOrder = self:_o(), Parent = self.frame,
    })
    corner(f, 5)
    create("TextLabel", {
        Text = o.Name, Font = FONT, TextSize = 13, TextColor3 = Theme.Text, BackgroundTransparency = 1,
        Position = UDim2.fromOffset(10, 4), Size = UDim2.new(1, -80, 0, 18), TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd, Parent = f,
    })
    local val = create("TextLabel", {
        Text = "", Font = FONT_M, TextSize = 12, TextColor3 = Theme.Accent, BackgroundTransparency = 1,
        Position = UDim2.new(1, -74, 0, 4), Size = UDim2.new(0, 64, 0, 18), TextXAlignment = Enum.TextXAlignment.Right, Parent = f,
    })
    local bar = create("TextButton", {
        Text = "", AutoButtonColor = false, Size = UDim2.new(1, -20, 0, 6), Position = UDim2.new(0, 10, 0, 28),
        BackgroundColor3 = Theme.Off, BorderSizePixel = 0, Parent = f,
    })
    corner(bar, 3)
    local fill = create("Frame", { Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = Theme.Accent, BorderSizePixel = 0, Parent = bar })
    corner(fill, 3)
    local step = o.Step or 1
    local el = {}
    local function fmt(v)
        local s = step < 1 and string.format("%.2f", v) or tostring(floor(v + 0.5))
        return s .. (o.Suffix or "")
    end
    function el:Set(v, silent)
        v = tonumber(v) or o.Min
        v = math.clamp(v, o.Min, o.Max)
        v = floor(v / step + 0.5) * step
        el.value = v
        F[o.Flag] = v
        fill.Size = UDim2.new((v - o.Min) / (o.Max - o.Min), 0, 1, 0)
        val.Text = fmt(v)
        if o.Callback and not silent then o.Callback(v) end
    end
    function el:Get() return el.value end
    local dragging = false
    local function upd(x)
        local r = math.clamp((x - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1)
        el:Set(o.Min + (o.Max - o.Min) * r)
    end
    bar.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            upd(i.Position.X)
        end
    end)
    bind(UserInputService.InputChanged, function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then upd(i.Position.X) end
    end)
    bind(UserInputService.InputEnded, function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = false end
    end)
    el:Set(F[o.Flag], true)
    Lib.Elements[o.Flag] = el
    return el
end

function Section:Dropdown(o)
    local opts = o.Options
    local holder = create("Frame", {
        Size = UDim2.new(1, 0, 0, 28), BackgroundColor3 = Theme.Elem, BorderSizePixel = 0, ClipsDescendants = true,
        LayoutOrder = self:_o(), Parent = self.frame,
    })
    corner(holder, 5)
    local head = create("TextButton", { Text = "", AutoButtonColor = false, Size = UDim2.new(1, 0, 0, 28), BackgroundTransparency = 1, Parent = holder })
    create("TextLabel", {
        Text = o.Name, Font = FONT, TextSize = 13, TextColor3 = Theme.Text, BackgroundTransparency = 1,
        Position = UDim2.fromOffset(10, 0), Size = UDim2.new(0.5, -10, 1, 0), TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd, Parent = head,
    })
    local valLbl = create("TextLabel", {
        Text = "", Font = FONT, TextSize = 12, TextColor3 = Theme.Accent, BackgroundTransparency = 1,
        Position = UDim2.new(0.5, 0, 0, 0), Size = UDim2.new(0.5, -26, 1, 0), TextXAlignment = Enum.TextXAlignment.Right,
        TextTruncate = Enum.TextTruncate.AtEnd, Parent = head,
    })
    local arrow = create("TextLabel", {
        Text = "▾", Font = FONT_B, TextSize = 12, TextColor3 = Theme.Sub, BackgroundTransparency = 1,
        Position = UDim2.new(1, -22, 0, 0), Size = UDim2.new(0, 16, 1, 0), Parent = head,
    })
    local list = create("Frame", {
        Position = UDim2.fromOffset(0, 28), Size = UDim2.new(1, 0, 0, #opts * 24 + 6), BackgroundTransparency = 1, Parent = holder,
    })
    pad(list, 6, 6, 0, 6)
    create("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder, Parent = list })
    local el = { open = false }
    local btns = {}
    local function selected(opt)
        if o.Multi then
            for _, v in ipairs(el.value or {}) do if v == opt then return true end end
            return false
        end
        return el.value == opt
    end
    local function refresh()
        for opt, b in pairs(btns) do
            local on = selected(opt)
            b.TextColor3 = on and Theme.Accent or Theme.Sub
            b.BackgroundTransparency = on and 0 or 1
        end
        if o.Multi then
            valLbl.Text = (#(el.value or {}) == 0) and "Ninguno" or table.concat(el.value, ", ")
        else
            valLbl.Text = tostring(el.value)
        end
    end
    function el:Set(v, silent)
        if o.Multi then
            local t = {}
            if type(v) == "table" then for _, x in ipairs(v) do t[#t + 1] = x end end
            v = t
        end
        el.value = v
        F[o.Flag] = v
        refresh()
        if o.Callback and not silent then task.spawn(o.Callback, v) end
    end
    function el:Get() return el.value end
    local function setOpen(on)
        el.open = on
        tw(holder, 0.22, { Size = UDim2.new(1, 0, 0, on and (28 + #opts * 24 + 6) or 28) })
        tw(arrow, 0.22, { Rotation = on and 180 or 0 })
    end
    for i, opt in ipairs(opts) do
        local b = create("TextButton", {
            Text = "  " .. opt, Font = FONT, TextSize = 12, TextColor3 = Theme.Sub, AutoButtonColor = false,
            BackgroundColor3 = Theme.Panel, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 22),
            TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = i, Parent = list,
        })
        corner(b, 4)
        btns[opt] = b
        b.MouseButton1Click:Connect(function()
            if o.Multi then
                local t, found = {}, false
                for _, x in ipairs(el.value or {}) do if x == opt then found = true else t[#t + 1] = x end end
                if not found then t[#t + 1] = opt end
                el:Set(t)
            else
                el:Set(opt)
                setOpen(false)
            end
        end)
    end
    head.MouseButton1Click:Connect(function() setOpen(not el.open) end)
    hover(holder)
    el:Set(F[o.Flag], true)
    Lib.Elements[o.Flag] = el
    return el
end

function Section:Button(o)
    local b = create("TextButton", {
        Text = o.Name, Font = FONT_M, TextSize = 13, TextColor3 = Theme.Text, AutoButtonColor = false,
        Size = UDim2.new(1, 0, 0, 28), BackgroundColor3 = Theme.Elem, BorderSizePixel = 0,
        LayoutOrder = self:_o(), Parent = self.frame,
    })
    corner(b, 5)
    local st = stroke(b, Theme.Stroke)
    hover(b)
    b.MouseButton1Click:Connect(function()
        tw(st, 0.08, { Color = Theme.Accent })
        task.delay(0.2, function() tw(st, 0.3, { Color = Theme.Stroke }) end)
        if o.Callback then task.spawn(o.Callback) end
    end)
    return b
end

function Section:Label(text)
    local l = create("TextLabel", {
        Text = text, Font = FONT, TextSize = 12, TextColor3 = Theme.Sub, BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left, RichText = true, LayoutOrder = self:_o(), Parent = self.frame,
    })
    local el = {}
    function el:Set(t) l.Text = t end
    return el
end

function Section:Stat(name)
    local f = create("Frame", { Size = UDim2.new(1, 0, 0, 20), BackgroundTransparency = 1, LayoutOrder = self:_o(), Parent = self.frame })
    create("TextLabel", {
        Text = name, Font = FONT, TextSize = 12, TextColor3 = Theme.Sub, BackgroundTransparency = 1,
        Size = UDim2.new(0.42, 0, 1, 0), TextXAlignment = Enum.TextXAlignment.Left, Parent = f,
    })
    local v = create("TextLabel", {
        Text = "—", Font = FONT_M, TextSize = 12, TextColor3 = Theme.Text, BackgroundTransparency = 1,
        Position = UDim2.fromScale(0.42, 0), Size = UDim2.new(0.58, 0, 1, 0), TextXAlignment = Enum.TextXAlignment.Right,
        TextTruncate = Enum.TextTruncate.AtEnd, Parent = f,
    })
    local el = {}
    function el:Set(t) v.Text = tostring(t) end
    return el
end

function Section:Input(o)
    local f = create("Frame", { Size = UDim2.new(1, 0, 0, 28), BackgroundColor3 = Theme.Elem, BorderSizePixel = 0, LayoutOrder = self:_o(), Parent = self.frame })
    corner(f, 5)
    create("TextLabel", {
        Text = o.Name, Font = FONT, TextSize = 13, TextColor3 = Theme.Text, BackgroundTransparency = 1,
        Position = UDim2.fromOffset(10, 0), Size = UDim2.new(0.42, -10, 1, 0), TextXAlignment = Enum.TextXAlignment.Left, Parent = f,
    })
    local box = create("TextBox", {
        Text = tostring(F[o.Flag] or ""), PlaceholderText = o.Placeholder or "", Font = FONT, TextSize = 12,
        TextColor3 = Theme.Accent, PlaceholderColor3 = Theme.Off, BackgroundColor3 = Theme.Panel, ClearTextOnFocus = false,
        Position = UDim2.new(0.42, 0, 0.5, -10), Size = UDim2.new(0.58, -8, 0, 20), TextXAlignment = Enum.TextXAlignment.Left, Parent = f,
    })
    corner(box, 4)
    pad(box, 6, 6, 0, 0)
    local el = {}
    function el:Set(v) box.Text = tostring(v) F[o.Flag] = tostring(v) end
    function el:Get() return box.Text end
    box.FocusLost:Connect(function()
        F[o.Flag] = box.Text
        if o.Callback then o.Callback(box.Text) end
    end)
    Lib.Elements[o.Flag] = el
    return el
end

function Section:Keybind(o)
    local f = create("Frame", { Size = UDim2.new(1, 0, 0, 28), BackgroundColor3 = Theme.Elem, BorderSizePixel = 0, LayoutOrder = self:_o(), Parent = self.frame })
    corner(f, 5)
    create("TextLabel", {
        Text = o.Name, Font = FONT, TextSize = 13, TextColor3 = Theme.Text, BackgroundTransparency = 1,
        Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -100, 1, 0), TextXAlignment = Enum.TextXAlignment.Left, Parent = f,
    })
    local kb = create("TextButton", {
        Text = "", Font = FONT_M, TextSize = 12, TextColor3 = Theme.Accent, AutoButtonColor = false, BackgroundColor3 = Theme.Panel,
        Position = UDim2.new(1, -90, 0.5, -10), Size = UDim2.fromOffset(82, 20), Parent = f,
    })
    corner(kb, 4)
    local el = { waiting = false }
    function el:Set(v) F[o.Flag] = v kb.Text = tostring(v) end
    function el:Get() return F[o.Flag] end
    kb.MouseButton1Click:Connect(function()
        el.waiting = true
        Lib.Binding = true
        kb.Text = "..."
    end)
    bind(UserInputService.InputBegan, function(i)
        if el.waiting and i.UserInputType == Enum.UserInputType.Keyboard then
            el.waiting = false
            task.delay(0.1, function() Lib.Binding = false end)
            if i.KeyCode == Enum.KeyCode.Escape then el:Set("None") else el:Set(i.KeyCode.Name) end
        end
    end)
    el:Set(F[o.Flag])
    Lib.Elements[o.Flag] = el
    return el
end

local function setFlag(flag, v)
    local e = Lib.Elements[flag]
    if e then e:Set(v) else F[flag] = v end
end

---------------------------------------------------------------------------
-- Funciones de soporte para la GUI
---------------------------------------------------------------------------
local function teleportTo(pos, surface)
    local h = getHRP()
    if not h or not pos then return end
    local cf = surface and CFrame.new(pos.X, groundY(pos) + 3.2, pos.Z) or CFrame.new(pos)
    Move.go(buildPath(h.Position, cf, "Abajo"), F.TweenSpeed * 1.4, "manual")
    task.spawn(function()
        local t0 = tick()
        while Hub.Alive and Move.owner == "manual" and not Move.arrived and tick() - t0 < 25 do task.wait(0.1) end
        if Move.owner == "manual" then Move.stop(false) end
    end)
end

local function scanReport()
    G.refresh()
    local lines = {}
    local function add(s) lines[#lines + 1] = s end
    add("== TAUPE · escaneo de Dandy's World ==")
    add("Sala actual: " .. (Cache.room and Cache.room:GetFullName() or "ninguna (lobby?)"))
    add(("Máquinas: %d · Twisteds: %d · Ítems: %d"):format(#Cache.gens, #Cache.monsters, #Cache.items))
    add("Elevador: " .. (Cache.elevator and Cache.elevator:GetFullName() or "no encontrado"))
    local g = Cache.gens[1]
    if g then
        add("Ejemplo máquina: " .. g:GetFullName())
        add("  Completed=" .. tostring(G.genDone(g)) .. "  Progress=" .. tostring(G.genProgress(g)) .. "  Prompt=" .. tostring(G.genPrompt(g) ~= nil))
        local st = g:FindFirstChild("Stats")
        if st then
            for _, v in ipairs(st:GetChildren()) do
                add("  Stats." .. v.Name .. " (" .. v.ClassName .. ")" .. (v:IsA("ValueBase") and (" = " .. tostring(v.Value)) or ""))
            end
        end
    end
    for _, m in ipairs(Cache.monsters) do add("Twisted: " .. m.Name .. (G.isRanged(m) and " [distancia]" or "")) end
    for _, it in ipairs(Cache.items) do add("Ítem: " .. it.Name) end
    local hp, mx = G.health(LP.Character)
    local st, smx = G.stamina(LP)
    add(("Tu vida: %s/%s · stamina: %s/%s"):format(tostring(hp), tostring(mx), tostring(st), tostring(smx)))
    local inv = G.inventory()
    local names = {}
    for _, e in ipairs(inv) do names[#names + 1] = e.name .. (e.slot and ("#" .. e.slot) or "") end
    add("Inventario: " .. (#names > 0 and table.concat(names, ", ") or "vacío / no detectado"))
    SC.frame = nil
    SC.scanT = 0
    local f = scFindFrame()
    add("Frame skill check: " .. (f and f:GetFullName() or "no encontrado (aparece al reparar)"))
    if f then
        local mk, ot, zs, pz = scParts(f)
        add(("  marcadores=%d otros=%d zonas=%d perfectas=%d"):format(#mk, #ot, #zs, #pz))
    end
    add("Remote skill check aprendido: " .. (SC.learned and SC.learned.remote:GetFullName() or "no"))
    local rem = {}
    for _, d in ipairs(ReplicatedStorage:GetDescendants()) do
        if (d:IsA("RemoteEvent") or d:IsA("RemoteFunction")) then
            local n = lower(d.Name)
            if n:find("skill") or n:find("buy") or n:find("purchase") or n:find("item") or n:find("gen") or n:find("abil") then rem[#rem + 1] = d.Name end
        end
    end
    add("Remotes relevantes: " .. (#rem > 0 and table.concat(rem, ", ") or "ninguno"))
    add("Executor: prompt=" .. tostring(X.fireprompt ~= nil) .. " touch=" .. tostring(X.firetouch ~= nil) .. " hook=" .. tostring(X.hookmm ~= nil) .. " VIM=" .. tostring(VIM ~= nil))
    local text = table.concat(lines, "\n")
    print(text)
    return text
end

local CFG_DIR, CFG_FILE = "TaupeHub", "TaupeHub/DandysWorld.json"
local function saveCfg(silent)
    if not X.writefile then if not silent then notify("Config", "Tu executor no soporta writefile.", "bad") end return end
    local ok = pcall(function()
        if X.makefolder and not (X.isfolder and X.isfolder(CFG_DIR)) then X.makefolder(CFG_DIR) end
        X.writefile(CFG_FILE, HttpService:JSONEncode(F))
    end)
    if not silent then notify("Config", ok and "Configuración guardada." or "No se pudo guardar.", ok and "good" or "bad") end
end
local function loadCfg(silent)
    if not (X.readfile and X.isfile) then return false end
    local ok, data = pcall(function()
        if X.isfile(CFG_FILE) then return HttpService:JSONDecode(X.readfile(CFG_FILE)) end
    end)
    if ok and type(data) == "table" then
        for k, v in pairs(data) do
            if Lib.Elements[k] then pcall(function() Lib.Elements[k]:Set(v) end)
            elseif F[k] ~= nil then F[k] = v end
        end
        if not silent then notify("Config", "Configuración cargada.", "good") end
        return true
    end
    if not silent then notify("Config", "No hay configuración guardada.", "bad") end
    return false
end

local function panic()
    for _, k in ipairs({ "AutoFarm", "AutoHide", "AutoDistract", "Fly", "Noclip", "TPWalk", "SmartVeemote", "MasteryFarm", "AutoQueue", "AutoAbility" }) do
        setFlag(k, false)
    end
    Move.stop(true)
    farmReset()
    notify("Pánico", "Toda la automatización fue desactivada.", "bad")
end


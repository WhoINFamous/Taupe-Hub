local LightSave
local function applyLighting()
    if F.Fullbright or F.NoFog then
        if not LightSave then
            LightSave = {
                Brightness = Lighting.Brightness, ClockTime = Lighting.ClockTime, FogEnd = Lighting.FogEnd,
                FogStart = Lighting.FogStart, GlobalShadows = Lighting.GlobalShadows, Ambient = Lighting.Ambient,
                OutdoorAmbient = Lighting.OutdoorAmbient, fx = {},
            }
        end
        for _, e in ipairs(Lighting:GetDescendants()) do
            if e:IsA("Atmosphere") then
                if LightSave.fx[e] == nil then LightSave.fx[e] = e.Density end
                e.Density = 0
            elseif F.Fullbright and (e:IsA("ColorCorrectionEffect") or e:IsA("BlurEffect") or e:IsA("BloomEffect")) then
                if LightSave.fx[e] == nil then LightSave.fx[e] = e.Enabled end
                e.Enabled = false
            end
        end
        if F.NoFog or F.Fullbright then Lighting.FogEnd = 1e6 Lighting.FogStart = 1e6 - 1 end
        if F.Fullbright then
            Lighting.Brightness = 2
            Lighting.ClockTime = 14
            Lighting.GlobalShadows = false
            Lighting.Ambient = Color3.fromRGB(178, 178, 178)
            Lighting.OutdoorAmbient = Color3.fromRGB(178, 178, 178)
        end
    elseif LightSave then
        for k, v in pairs(LightSave) do if k ~= "fx" then pcall(function() Lighting[k] = v end) end end
        for e, v in pairs(LightSave.fx) do
            pcall(function()
                if e:IsA("Atmosphere") then e.Density = v else e.Enabled = v end
            end)
        end
        LightSave = nil
    end
end


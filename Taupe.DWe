local Top = create("Frame", { Size = UDim2.new(1, 0, 0, 38), BackgroundColor3 = Theme.Side, BorderSizePixel = 0, Parent = Main })
create("Frame", { Size = UDim2.new(1, 0, 0, 1), Position = UDim2.new(0, 0, 1, -1), BackgroundColor3 = Theme.Stroke, BorderSizePixel = 0, Parent = Top })

---------------------------------------------------------------------------
-- Notificaciones (toasts)
---------------------------------------------------------------------------
local NotifHolder = create("Frame", {
    AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -16, 1, -16),
    Size = UDim2.fromOffset(290, 420), BackgroundTransparency = 1, Parent = Gui,
})
create("UIListLayout", {
    Padding = UDim.new(0, 6), VerticalAlignment = Enum.VerticalAlignment.Bottom,
    SortOrder = Enum.SortOrder.LayoutOrder, Parent = NotifHolder,
})
local notifCount = 0

local function notify(title, text, kind, dur)
    if not Hub.Alive then return end
    notifCount = notifCount + 1
    local col = (kind == "bad" and Theme.Bad) or (kind == "good" and Theme.Good) or Theme.Accent
    local n = create("Frame", {
        Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundColor3 = Theme.Panel, BackgroundTransparency = 1, BorderSizePixel = 0,
        LayoutOrder = notifCount, Parent = NotifHolder,
    })
    corner(n, 6)
    local st = stroke(n)
    st.Transparency = 1
    local bar = create("Frame", {
        Size = UDim2.new(0, 3, 1, -14), Position = UDim2.new(0, 6, 0, 7), BackgroundColor3 = col,
        BackgroundTransparency = 1, BorderSizePixel = 0, Parent = n,
    })
    corner(bar, 2)
    local body = create("Frame", {
        Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Parent = n,
    })
    pad(body, 16, 10, 8, 9)
    create("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder, Parent = body })
    local t1 = create("TextLabel", {
        Text = tostring(title), Font = FONT_B, TextSize = 13, TextColor3 = Theme.Text, TextTransparency = 1,
        BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 16), TextXAlignment = Enum.TextXAlignment.Left,
        LayoutOrder = 1, Parent = body,
    })
    local t2 = create("TextLabel", {
        Text = tostring(text or ""), Font = FONT, TextSize = 12, TextColor3 = Theme.Sub, TextTransparency = 1,
        BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = 2, Parent = body,
    })
    tw(n, 0.25, { BackgroundTransparency = 0.04 })
    tw(st, 0.25, { Transparency = 0 })
    tw(bar, 0.25, { BackgroundTransparency = 0 })
    tw(t1, 0.25, { TextTransparency = 0 })
    tw(t2, 0.25, { TextTransparency = 0 })
    -- limitar cantidad
    local frames = {}
    for _, c in ipairs(NotifHolder:GetChildren()) do if c:IsA("Frame") then frames[#frames + 1] = c end end
    if #frames > 6 then
        table.sort(frames, function(a, b) return a.LayoutOrder < b.LayoutOrder end)
        frames[1]:Destroy()
    end
    task.delay(dur or 4.5, function()
        if not n.Parent then return end
        tw(n, 0.3, { BackgroundTransparency = 1 })
        tw(st, 0.3, { Transparency = 1 })
        tw(bar, 0.3, { BackgroundTransparency = 1 })
        tw(t1, 0.3, { TextTransparency = 1 })
        tw(t2, 0.3, { TextTransparency = 1 })
        task.wait(0.32)
        n:Destroy()
    end)
end

---------------------------------------------------------------------------
-- Capa de juego (detección adaptativa)
---------------------------------------------------------------------------
local Cache = { room = nil, gens = {}, monsters = {}, items = {}, elevator = nil, elevScanT = 0 }
local G = {}

local function modelsIn(folder)
    local t = {}
    if folder then
        for _, c in ipairs(folder:GetChildren()) do
            if c:IsA("Model") or c:IsA("BasePart") or c:IsA("Tool") then t[#t + 1] = c end
        end
    end
    return t
end

local fallbackRoom, fallbackT = nil, 0
function G.room()
    local cr = workspace:FindFirstChild("CurrentRoom") or workspace:FindFirstChild("CurrentRooms")
    if cr then
        for _, c in ipairs(cr:GetChildren()) do
            if (c:IsA("Model") or c:IsA("Folder")) and (c:FindFirstChild("Generators") or c:FindFirstChild("Monsters") or c:FindFirstChild("Items")) then
                return c
            end
        end
        local first = cr:FindFirstChildWhichIsA("Model") or cr:FindFirstChildWhichIsA("Folder")
        if first then return first end
    end
    if tick() - fallbackT > 3 then
        fallbackT = tick()
        local gf = workspace:FindFirstChild("Generators", true)
        fallbackRoom = gf and gf.Parent or nil
    end
    if fallbackRoom and fallbackRoom.Parent then return fallbackRoom end
    return nil
end

local function isPlayerChar(m)
    return Players:GetPlayerFromCharacter(m) ~= nil
end

function G.refresh()
    local room = G.room()
    if room ~= Cache.room then
        Cache.elevator = nil
        Cache.elevScanT = 0
    end
    Cache.room = room
    if not room then
        Cache.gens, Cache.monsters, Cache.items = {}, {}, {}
        return
    end
    Cache.gens = modelsIn(room:FindFirstChild("Generators"))
    Cache.items = modelsIn(room:FindFirstChild("Items"))
    local mf = room:FindFirstChild("Monsters")
    local mons = modelsIn(mf)
    if #mons == 0 then
        for _, c in ipairs(workspace:GetChildren()) do
            if c:IsA("Model") and c:FindFirstChildOfClass("Humanoid") and not isPlayerChar(c) then
                local n = lower(c.Name)
                if n:find("monster") or n:find("twisted") then mons[#mons + 1] = c end
            end
        end
    end
    Cache.monsters = mons
    if (not Cache.elevator or not Cache.elevator.Parent) and tick() - Cache.elevScanT > 3 then
        Cache.elevScanT = tick()
        local e = room:FindFirstChild("Elevator") or room:FindFirstChild("ElevatorExit") or room:FindFirstChild("Exit")
        if not e then
            for _, d in ipairs(room:GetDescendants()) do
                if d:IsA("Model") and lower(d.Name):find("elevator") then e = d break end
            end
        end
        if not e then
            local ef = workspace:FindFirstChild("Elevators")
            local hrp = getHRP()
            if ef and hrp then
                local best, bd
                for _, c in ipairs(ef:GetChildren()) do
                    local p = posOf(c)
                    if p then
                        local d = (p - hrp.Position).Magnitude
                        if not bd or d < bd then best, bd = c, d end
                    end
                end
                e = best
            end
        end
        Cache.elevator = e
    end
end

function G.genDone(g)
    local c = findVal(statRoots(g), { "Completed", "Complete", "Finished", "Done", "Fixed", "Repaired" })
    if c ~= nil then return c == true end
    local p = G.genProgress(g)
    return p ~= nil and p >= 100
end

function G.genProgress(g)
    local p = findVal(statRoots(g), { "Completion", "Progress", "Percent", "Percentage", "Charge" })
    if type(p) == "number" then return p end
    return nil
end

function G.genPrompt(g)
    return g:FindFirstChildWhichIsA("ProximityPrompt", true)
end

function G.genOccupied(g)
    local ap = findVal(statRoots(g), { "ActivePlayer", "Player", "User", "Repairer" })
    if typeof(ap) == "Instance" and ap ~= LP and ap ~= LP.Character then return true end
    local p = posOf(g)
    if not p then return false end
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl ~= LP and pl.Character then
            local r = pl.Character:FindFirstChild("HumanoidRootPart")
            if r and (r.Position - p).Magnitude < 7 then return true end
        end
    end
    return false
end

function G.twName(m)
    local n = m.Name:gsub("Monster", ""):gsub("Twisted", ""):gsub("_", " ")
    n = n:gsub("^%s+", ""):gsub("%s+$", "")
    if n == "" then n = m.Name end
    return n
end

local MAIN_TWISTEDS = { "dandy", "astro", "pebble", "shelly", "sprout", "vee", "dyle" }
function G.isMain(m) return hasAny(G.twName(m), MAIN_TWISTEDS) end
function G.isRanged(m) return hasAny(m.Name, splitList(F.RangedNames)) end

function G.nearestMonster(pos)
    local best, bd
    if not pos then return nil end
    for _, m in ipairs(Cache.monsters) do
        local p = posOf(m)
        if p then
            local d = (p - pos).Magnitude
            if not bd or d < bd then best, bd = m, d end
        end
    end
    return best, bd
end

function G.health(char)
    if not char then return nil end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local hp = findVal(statRoots(char), { "Health", "Hearts", "HP" })
    local mx = findVal(statRoots(char), { "MaxHealth", "MaxHearts", "MaxHP" })
    if type(hp) ~= "number" and hum then hp, mx = hum.Health, hum.MaxHealth end
    if type(hp) ~= "number" then return nil end
    if type(mx) ~= "number" or mx <= 0 then mx = (hum and hum.MaxHealth) or hp end
    return hp, mx
end

function G.stamina(player)
    local char = player.Character
    local roots = {}
    for _, r in ipairs(statRoots(char)) do roots[#roots + 1] = r end
    for _, r in ipairs(statRoots(player)) do roots[#roots + 1] = r end
    local st = findVal(roots, { "Stamina", "CurrentStamina", "Energy" })
    local mx = findVal(roots, { "MaxStamina", "StaminaMax", "MaxEnergy" })
    if type(st) ~= "number" then return nil end
    if type(mx) ~= "number" or mx <= 0 then mx = 100 end
    return st, mx
end

function G.inventory()
    local list = {}
    local bp = LP:FindFirstChildOfClass("Backpack")
    if bp then for _, t in ipairs(bp:GetChildren()) do if t:IsA("Tool") then list[#list + 1] = { name = t.Name, obj = t } end end end
    local ch = LP.Character
    if ch then for _, t in ipairs(ch:GetChildren()) do if t:IsA("Tool") then list[#list + 1] = { name = t.Name, obj = t } end end end
    for _, root in ipairs({ LP, ch }) do
        if root then
            local inv = root:FindFirstChild("Inventory") or root:FindFirstChild("Items") or root:FindFirstChild("Slots")
            if inv then
                for i, v in ipairs(inv:GetChildren()) do
                    local nm = (v:IsA("StringValue") and v.Value ~= "" and v.Value) or v:GetAttribute("Item") or v.Name
                    if nm and nm ~= "" and lower(tostring(nm)) ~= "none" and lower(tostring(nm)) ~= "empty" then
                        list[#list + 1] = { name = tostring(nm), obj = v, slot = tonumber(v.Name:match("%d+")) or i }
                    end
                end
            end
        end
    end
    return list
end

function G.findItem(keys)
    for _, e in ipairs(G.inventory()) do
        if hasAny(e.name, keys) then return e end
    end
    return nil
end

function G.useItem(e)
    if not e then return false end
    local hum = getHum()
    if e.obj:IsA("Tool") then
        if e.obj.Parent ~= LP.Character and hum then
            pcall(function() hum:EquipTool(e.obj) end)
            task.wait(0.12)
        end
        pcall(function() e.obj:Activate() end)
        if VIM then
            local vp = workspace.CurrentCamera.ViewportSize
            clickAt(vp.X / 2, vp.Y / 2)
        end
        return true
    end
    if e.slot and SLOT_KEYS[e.slot] then
        pressKey(SLOT_KEYS[e.slot])
        if F.ItemUse == "Slot + clic" then
            task.delay(0.1, function()
                local vp = workspace.CurrentCamera.ViewportSize
                clickAt(vp.X / 2, vp.Y / 2)
            end)
        end
        return true
    end
    return false
end

local floorValueObj
function G.floorNumber()
    if floorValueObj and floorValueObj.Parent then return floorValueObj.Value end
    for _, root in ipairs({ ReplicatedStorage, workspace }) do
        for _, n in ipairs({ "CurrentFloor", "Floor", "FloorNumber", "Level" }) do
            local a = root:GetAttribute(n)
            if type(a) == "number" then return a end
            local v = root:FindFirstChild(n, true)
            if v and (v:IsA("IntValue") or v:IsA("NumberValue")) then
                floorValueObj = v
                return v.Value
            end
        end
    end
    return nil
end

-- Raycasts
local RP = RaycastParams.new()
RP.FilterType = Enum.RaycastFilterType.Exclude
local function rayFilter()
    local ex = {}
    for _, p in ipairs(Players:GetPlayers()) do if p.Character then ex[#ex + 1] = p.Character end end
    if Cache.room then
        for _, n in ipairs({ "Monsters", "Generators", "Items" }) do
            local f = Cache.room:FindFirstChild(n)
            if f then ex[#ex + 1] = f end
        end
    end
    for _, m in ipairs(Cache.monsters) do ex[#ex + 1] = m end
    RP.FilterDescendantsInstances = ex
end

local function groundY(pos)
    rayFilter()
    local r = workspace:Raycast(pos + Vector3.new(0, 4, 0), Vector3.new(0, -70, 0), RP)
    return r and r.Position.Y or (pos.Y - 3)
end

local function isUnderground()
    local h = getHRP()
    if not h then return false end
    rayFilter()
    local down = workspace:Raycast(h.Position, Vector3.new(0, -5, 0), RP)
    if down then return false end
    local up = workspace:Raycast(h.Position, Vector3.new(0, 22, 0), RP)
    return up ~= nil
end

---------------------------------------------------------------------------
-- Movimiento (tween manual por Heartbeat, cancelable, replicable)
---------------------------------------------------------------------------
local Move = { path = nil, i = 0, speed = 38, active = false, owner = nil, arrived = false, lastSurface = nil }

function Move.go(path, speed, owner)
    Move.path = path
    Move.i = 1
    Move.speed = speed or F.TweenSpeed
    Move.owner = owner
    Move.active = true
    Move.arrived = false
end

function Move.resurface()
    local h = getHRP()
    if not h then return end
    local p = h.Position
    rayFilter()
    local up = workspace:Raycast(p, Vector3.new(0, 30, 0), RP)
    if up then
        local down = workspace:Raycast(Vector3.new(p.X, up.Position.Y + 7, p.Z), Vector3.new(0, -9, 0), RP)
        local y = down and down.Position.Y or (up.Position.Y + 2)
        h.CFrame = CFrame.new(p.X, y + 3.2, p.Z) * (h.CFrame - h.CFrame.Position)
    elseif Move.lastSurface then
        h.CFrame = Move.lastSurface
    end
    h.AssemblyLinearVelocity = Vector3.zero
end

function Move.stop(resurface)
    local wasActive = Move.active
    Move.active = false
    Move.path = nil
    Move.owner = nil
    Move.arrived = false
    if resurface and wasActive and isUnderground() then Move.resurface() end
end

-- Ruta según modo: Directo / Abajo / Arriba
local function buildPath(fromPos, toCF, mode)
    local to = toCF.Position
    local rot = toCF - to
    mode = mode or F.FarmRoute
    if mode == "Directo" or (fromPos - to).Magnitude < 6 then return { toCF } end
    if mode == "Abajo" then
        local y = math.min(to.Y, groundY(fromPos) + 3 - math.max(F.FarmDepth, 6), groundY(to) + 3 - math.max(F.FarmDepth, 6))
        return { CFrame.new(fromPos.X, y, fromPos.Z) * rot, CFrame.new(to.X, y, to.Z) * rot, toCF }
    end
    local y = math.max(fromPos.Y, to.Y) + F.SkyHeight
    return { CFrame.new(fromPos.X, y, fromPos.Z) * rot, CFrame.new(to.X, y, to.Z) * rot, toCF }
end

---------------------------------------------------------------------------
-- Skill check (visual + remote aprendido)
---------------------------------------------------------------------------
local SC = { frame = nil, scanT = 0, prev = {}, lastPress = 0, wasShown = false, learned = nil, hooked = false, oldNC = nil }
local MARK_K = { "marker", "needle", "pointer", "cursor", "arrow", "indicator", "line", "hand", "tick", "slider" }
local ZONE_PERFECT = { "gold", "great", "perfect", "crit", "excellent" }
local ZONE_ANY = { "zone", "area", "target", "success", "good", "green", "hit", "region", "sweet", "gold", "great", "perfect" }

local function scFindFrame()
    if SC.frame and SC.frame.Parent then return SC.frame end
    if tick() - SC.scanT < 1 then return nil end
    SC.scanT = tick()
    local pg = LP:FindFirstChildOfClass("PlayerGui")
    if not pg then return nil end
    for _, d in ipairs(pg:GetDescendants()) do
        if d:IsA("GuiObject") then
            local n = lower(d.Name)
            if (n:find("skill") and n:find("check")) or n:find("calibrat") then
                SC.frame = d
                return d
            end
        end
    end
    return nil
end

-- Devuelve: marcadores por nombre, resto de objetos (fallback), zonas, zonas perfectas
local function scParts(frame)
    local marks, others, zones, pzones = {}, {}, {}, {}
    for _, d in ipairs(frame:GetDescendants()) do
        if d:IsA("GuiObject") and d.Visible then
            local n = lower(d.Name)
            local isZone, isPerfect, isMark = false, false, false
            for _, k in ipairs(ZONE_ANY) do if n:find(k, 1, true) then isZone = true break end end
            for _, k in ipairs(ZONE_PERFECT) do if n:find(k, 1, true) then isPerfect = true break end end
            if isZone then
                zones[#zones + 1] = d
                if isPerfect then pzones[#pzones + 1] = d end
            else
                for _, k in ipairs(MARK_K) do if n:find(k, 1, true) then isMark = true break end end
                if isMark then marks[#marks + 1] = d else others[#others + 1] = d end
            end
        end
    end
    return marks, others, zones, pzones
end

local function angDiff(a, b)
    local d = (a - b) % 360
    if d > 180 then d = d - 360 end
    return abs(d)
end

local function scPress()
    if tick() - SC.lastPress < 0.18 then return end
    SC.lastPress = tick()
    if F.SCKey == "Clic" then
        local vp = workspace.CurrentCamera.ViewportSize
        clickAt(vp.X / 2, vp.Y / 2)
    else
        pressKey(keyFromName(F.SCKey) or Enum.KeyCode.Space)
    end
    if F.SCButtons and SC.frame then
        for _, d in ipairs(SC.frame:GetDescendants()) do
            if d:IsA("GuiButton") and d.Visible then clickGui(d) break end
        end
    end
end

local function scReplay()
    local L = SC.learned
    if not L or not L.remote or not L.remote.Parent then return false end
    local args = {}
    for i = 1, L.args.n do args[i] = L.args[i] end
    task.delay(F.SCInstantDelay, function()
        pcall(function()
            if L.method == "InvokeServer" then L.remote:InvokeServer(table.unpack(args, 1, L.args.n))
            else L.remote:FireServer(table.unpack(args, 1, L.args.n)) end
        end)
    end)
    return true
end

local function scInstallHook()
    if SC.hooked or not (X.hookmm and X.getncm) then return SC.hooked end
    local wrap = X.newcc or function(f) return f end
    local ok = pcall(function()
        SC.oldNC = X.hookmm(game, "__namecall", wrap(function(self, ...)
            if Hub.Alive and F.SCMode == "Remote (aprendido)" then
                local m = X.getncm()
                if (m == "FireServer" or m == "InvokeServer") and not (X.checkcaller and X.checkcaller()) then
                    local okn, nm = pcall(function() return self.Name end)
                    if okn and type(nm) == "string" then
                        local l = lower(nm)
                        if l:find("skill") or l:find("check") or l:find("calib") then
                            SC.learned = { remote = self, method = m, args = table.pack(...) }
                        end
                    end
                end
            end
            return SC.oldNC(self, ...)
        end))
    end)
    SC.hooked = ok
    return ok
end

local function scStep(dt)
    if not (F.AutoSkillCheck or F.AutoFarm) then return end
    local frame = scFindFrame()
    if not frame then return end
    local shown = isShown(frame)
    if shown and not SC.wasShown then
        SC.prev = {}
        if F.SCMode == "Remote (aprendido)" and SC.learned then
            SC.wasShown = true
            SC.usedRemote = scReplay()
            return
        end
        SC.usedRemote = false
    end
    SC.wasShown = shown
    if not shown or SC.usedRemote then return end

    local marks, others, zones, pzones = scParts(frame)
    if #zones == 0 then return end
    local targets = (F.SCPerfect and #pzones > 0) and pzones or zones

    -- El marcador es el objeto que se mueve más rápido (prioriza los nombrados)
    local now = {}
    local function fastest(list)
        local best, bs, bv, ba, bp, br = nil, 5, nil, nil, nil, nil
        for _, mk in ipairs(list) do
            local c = mk.AbsolutePosition + mk.AbsoluteSize / 2
            local r = mk.AbsoluteRotation
            now[mk] = { pos = c, rot = r }
            local pv = SC.prev[mk]
            if pv and dt > 0 then
                local v = (c - pv.pos) / dt
                local av = (r - pv.rot) / dt
                local sp = math.max(v.Magnitude, abs(av))
                if sp > bs then best, bs, bv, ba, bp, br = mk, sp, v, av, c, r end
            end
        end
        return best, bv, ba, bp, br
    end
    local marker, vel, angVel, mc, rot = fastest(marks)
    if not marker then marker, vel, angVel, mc, rot = fastest(others) end
    SC.prev = now
    if not marker then return end

    local lead = F.SCLead
    local pred = mc + vel * lead
    local linear = vel.Magnitude > 5
    local angular = abs(angVel) > 5
    for _, z in ipairs(targets) do
        local hit = false
        if linear then
            local zp, zs = z.AbsolutePosition, z.AbsoluteSize
            if abs(vel.X) >= abs(vel.Y) then
                local m = zs.X * 0.12
                hit = pred.X >= zp.X + m and pred.X <= zp.X + zs.X - m
            else
                local m = zs.Y * 0.12
                hit = pred.Y >= zp.Y + m and pred.Y <= zp.Y + zs.Y - m
            end
        elseif angular then
            hit = angDiff(rot + angVel * lead, z.AbsoluteRotation) <= F.SCAngleTol
        end
        if hit then scPress() return end
    end
end

---------------------------------------------------------------------------
-- Farm (estilo autopiloto: tween + noclip + skill check + evasión)
---------------------------------------------------------------------------
local Farm = { phase = "idle", gen = nil, prompt = nil, cf = nil, startT = 0, workStart = 0,
    lastProg = nil, lastProgT = 0, lastPrompt = 0, blacklist = {}, itemBL = {}, status = "Inactivo", item = nil }
local Heat = {}

local function workCF(g)
    local pr = G.genPrompt(g)
    local part = pr and pr.Parent
    if part and part:IsA("Attachment") then part = part.Parent end
    if not (part and part:IsA("BasePart")) then part = partOf(g) end
    if not part then return nil end
    local center = posOf(g) or part.Position
    local base = part.Position
    local dir = Vector3.new(base.X - center.X, 0, base.Z - center.Z)
    if dir.Magnitude < 0.5 then
        local lv = part.CFrame.LookVector
        dir = Vector3.new(lv.X, 0, lv.Z)
        if dir.Magnitude < 0.1 then dir = Vector3.new(0, 0, 1) end
    end
    dir = dir.Unit
    local stand = base + dir * 2.5
    local gy = groundY(Vector3.new(stand.X, base.Y + 2, stand.Z))
    local y = gy + 3.2
    if F.FarmPos == "Bajo el suelo" then y = y - F.FarmDepth end
    local p = Vector3.new(stand.X, y, stand.Z)
    local look = Vector3.new(center.X, y, center.Z)
    if (look - p).Magnitude < 0.1 then return CFrame.new(p), pr end
    return CFrame.lookAt(p, look), pr
end

local function surfaceOrFarmCF(pos)
    local y = groundY(pos) + 3.2
    if F.FarmPos == "Bajo el suelo" then y = y - F.FarmDepth end
    return CFrame.new(pos.X, y, pos.Z)
end

local function genDanger(g)
    local p = posOf(g)
    if not p then return 0 end
    local s = 0
    for _, m in ipairs(Cache.monsters) do
        local mp = posOf(m)
        if mp then
            local d = (mp - p).Magnitude
            if d < F.EvadeRadius * 1.6 then s = s + (F.EvadeRadius * 1.6 - d) end
        end
    end
    return s
end

local function pickGen()
    local h = getHRP()
    if not h then return nil end
    local best, bs
    for _, g in ipairs(Cache.gens) do
        if not G.genDone(g) and (Farm.blacklist[g] or 0) < tick() and not (F.SkipOccupied and G.genOccupied(g)) then
            local p = posOf(g)
            if p then
                local dist = (p - h.Position).Magnitude
                local danger = genDanger(g)
                local _, md = G.nearestMonster(p)
                local blocked = F.FarmEvade and md ~= nil and md < F.EvadeRadius
                if not blocked then
                    local prog = G.genProgress(g) or 0
                    local s
                    if F.FarmPriority == "Cercanía" then s = dist
                    elseif F.FarmPriority == "Más progreso" then s = dist - prog * 4
                    elseif F.FarmPriority == "Menos peligro" then s = danger * 50 + dist * 0.2
                    else s = dist + danger * 18 - prog * 1.5 end
                    if not bs or s < bs then best, bs = g, s end
                end
            end
        end
    end
    return best
end

local function nearestItem(maxDist)
    local h = getHRP()
    if not h then return nil end
    local best, bd
    for _, it in ipairs(Cache.items) do
        if (Farm.itemBL[it] or 0) < tick() then
            local p = posOf(it)
            if p then
                local d = (p - h.Position).Magnitude
                if (not maxDist or d <= maxDist) and (not bd or d < bd) then
                    local _, md = G.nearestMonster(p)
                    if not (F.FarmEvade and md and md < F.EvadeRadius) then best, bd = it, d end
                end
            end
        end
    end
    return best
end

local function collectItem(it)
    local pr = it:FindFirstChildWhichIsA("ProximityPrompt", true)
    if pr then usePrompt(pr) end
    local h, part = getHRP(), partOf(it)
    if X.firetouch and h and part then
        pcall(X.firetouch, h, part, 0)
        task.delay(0.05, function() pcall(X.firetouch, h, part, 1) end)
    end
end

local function holdUnderHere(owner)
    local h = getHRP()
    if not h then return end
    if Farm.holding and Move.active and Move.owner == owner then return end
    Farm.holding = true
    if isUnderground() then
        Move.go({ h.CFrame }, F.TweenSpeed, owner)
        return
    end
    local p = h.Position
    Move.go({ CFrame.new(p.X, groundY(p) + 3.2 - math.max(F.FarmDepth, 7), p.Z) }, F.TweenSpeed, owner)
end

local function farmReset()
    Farm.phase, Farm.gen, Farm.prompt, Farm.item = "idle", nil, nil, nil
end

local function farmGo(path, phase, status)
    Farm.holding = false
    Move.go(path, F.TweenSpeed, "farm")
    Farm.phase, Farm.startT, Farm.status = phase, tick(), status
end

local function farmTick()
    local h, hum = getHRP(), getHum()
    if not h or not hum or hum.Health <= 0 then Farm.status = "Esperando personaje" farmReset() return end
    if not Cache.room or #Cache.gens == 0 then
        Farm.status = "Esperando piso / lobby"
        if Move.owner == "farm" then Move.stop(true) end
        farmReset()
        return
    end

    -- Evasión: un twisted se acercó a la máquina actual
    if F.FarmEvade and Farm.gen and (Farm.phase == "travel" or Farm.phase == "work") then
        local _, d = G.nearestMonster(posOf(Farm.gen))
        if d and d < F.EvadeRadius then
            Farm.blacklist[Farm.gen] = tick() + 6
            farmReset()
            Farm.status = "Evadiendo twisted"
        end
    end

    if Farm.phase == "idle" then
        -- Desvío corto por ítems cercanos
        if F.FarmItems then
            local it = nearestItem(F.ItemDetour)
            if it then
                Farm.item = it
                farmGo(buildPath(h.Position, surfaceOrFarmCF(posOf(it))), "item", "Recogiendo ítem")
                return
            end
        end
        local g = pickGen()
        if g then
            local cf, pr = workCF(g)
            if cf then
                Farm.gen, Farm.prompt, Farm.cf = g, pr, cf
                farmGo(buildPath(h.Position, cf), "travel", "Viajando a máquina")
                return
            end
        end
        local allDone = true
        for _, gg in ipairs(Cache.gens) do if not G.genDone(gg) then allDone = false break end end
        if allDone then
            if F.FarmItems then
                local it = nearestItem(nil)
                if it then
                    Farm.item = it
                    farmGo(buildPath(h.Position, surfaceOrFarmCF(posOf(it))), "item", "Recogiendo ítems restantes")
                    return
                end
            end
            if F.FarmElevator and Cache.elevator then
                local e = Cache.elevator
                local target
                for _, d in ipairs(e:GetDescendants()) do
                    if d:IsA("BasePart") then
                        local n = lower(d.Name)
                        if n:find("zone") or n:find("inside") or n:find("hitbox") or n:find("trigger") or n:find("detect") or n:find("region") then target = d break end
                    end
                end
                local p = target and target.Position or posOf(e)
                if p then
                    farmGo(buildPath(h.Position, CFrame.new(p.X, groundY(p) + 3.2, p.Z)), "elevator", "Yendo al elevador")
                    return
                end
            end
            Farm.status = "Piso completo"
        else
            Farm.status = "Máquinas bloqueadas · esperando"
            holdUnderHere("farm")
        end
        return
    end

    if Farm.phase == "item" then
        local it = Farm.item
        if not it or not it.Parent then farmReset() return end
        if Move.arrived then
            collectItem(it)
            Farm.itemBL[it] = tick() + 4
            farmReset()
        elseif tick() - Farm.startT > 20 then
            Farm.itemBL[it] = tick() + 15
            farmReset()
        end
        return
    end

    if Farm.phase == "travel" then
        local g = Farm.gen
        if not g or not g.Parent or G.genDone(g) then farmReset() return end
        if Move.arrived then
            Farm.phase = "work"
            Farm.workStart, Farm.lastPrompt = tick(), 0
            Farm.lastProg, Farm.lastProgT = G.genProgress(g), tick()
        elseif tick() - Farm.startT > 45 then
            Farm.blacklist[g] = tick() + 10
            farmReset()
        end
        return
    end

    if Farm.phase == "work" then
        local g = Farm.gen
        if not g or not g.Parent then farmReset() return end
        if G.genDone(g) then
            farmReset()
            Farm.status = "Máquina completada"
            return
        end
        local p = G.genProgress(g)
        if p and p ~= Farm.lastProg then Farm.lastProg, Farm.lastProgT = p, tick() end
        if tick() - Farm.lastPrompt > 3 and tick() - Farm.lastProgT > 2.2 then
            usePrompt(Farm.prompt or G.genPrompt(g))
            Farm.lastPrompt = tick()
        end
        if tick() - Farm.workStart > F.GenTimeout then
            Farm.blacklist[g] = tick() + 25
            farmReset()
            return
        end
        Farm.status = ("Reparando máquina · %s"):format(p and (floor(p) .. "%") or "...")
        return
    end

    if Farm.phase == "elevator" then
        if Move.arrived then Farm.status = "En el elevador · esperando" end
        return
    end
end

---------------------------------------------------------------------------
-- Auto-hide / Auto-distract
---------------------------------------------------------------------------
local Hide = { target = nil, origin = nil, lastDanger = 0, returning = false }

local function hideTarget(threatPos)
    local h = getHRP()
    local p = h.Position
    if F.HideMode == "Cielo" then
        return CFrame.new(p.X, groundY(p) + 3.2 + 40, p.Z)
    elseif F.HideMode == "Punto seguro" then
        local cands = {}
        for _, g in ipairs(Cache.gens) do local gp = posOf(g) if gp then cands[#cands + 1] = gp end end
        for _, it in ipairs(Cache.items) do local ip = posOf(it) if ip then cands[#cands + 1] = ip end end
        if Cache.elevator then local ep = posOf(Cache.elevator) if ep then cands[#cands + 1] = ep end end
        local best, bs
        for _, c in ipairs(cands) do
            local _, md = G.nearestMonster(c)
            md = md or 999
            if not bs or md > bs then best, bs = c, md end
        end
        if best then return CFrame.new(best.X, groundY(best) + 3.2 - F.HideDepth, best.Z) end
    end
    if isUnderground() then return h.CFrame end
    return CFrame.new(p.X, groundY(p) + 3.2 - F.HideDepth, p.Z)
end

local function hideStep()
    local h = getHRP()
    if not h then return end
    if not Hide.target then
        if Move.owner == "farm" then farmReset() end
        Hide.origin = (not isUnderground()) and h.CFrame or Move.lastSurface
        Hide.target = hideTarget()
        local path = (F.HideMode == "Punto seguro") and buildPath(h.Position, Hide.target, "Abajo") or { Hide.target }
        Move.go(path, F.TweenSpeed * 1.6, "hide")
    end
end

local Dis = { angle = 0 }
local function distractStep(dt)
    local h = getHRP()
    if not h then return false end
    local target
    if F.DistractTrigger == "Siempre" then
        target = G.nearestMonster(h.Position)
    else
        local bd
        for _, pl in ipairs(Players:GetPlayers()) do
            if pl ~= LP and pl.Character then
                local r = pl.Character:FindFirstChild("HumanoidRootPart")
                if r then
                    local m, d = G.nearestMonster(r.Position)
                    if m and d < F.DangerRadius and (not bd or d < bd) then target, bd = m, d end
                end
            end
        end
    end
    if not target then return false end
    local mp = posOf(target)
    if not mp then return false end
    local ranged = G.isRanged(target)
    local r = ranged and F.DistractRadiusRanged or F.DistractRadius
    local ht = ranged and F.DistractHeightRanged or F.DistractHeight
    Dis.angle = Dis.angle + dt * F.DistractOrbit * (ranged and 1.6 or 1)
    local jitter = ranged and Vector3.new(0, math.sin(tick() * 4) * 2.5, 0) or Vector3.zero
    local pos = mp + Vector3.new(math.cos(Dis.angle) * r, ht, math.sin(Dis.angle) * r) + jitter
    Move.go({ CFrame.lookAt(pos, Vector3.new(mp.X, pos.Y, mp.Z)) }, F.TweenSpeed * (ranged and 2 or 1.5), "distract")
    return true
end

---------------------------------------------------------------------------
-- Cerebro (prioridades: Hide > Farm > Distract)
---------------------------------------------------------------------------
local Vee = { last = 0, busy = false }

local function brainTick(dt)
    local h, hum = getHRP(), getHum()
    if not h or not hum or hum.Health <= 0 then
        if Move.active then Move.stop(false) end
        Hide.target = nil
        return
    end
    if hum.FloorMaterial ~= Enum.Material.Air and not Move.active then Move.lastSurface = h.CFrame end
    if Vee.busy then return end

    -- Auto-hide
    local farmSafe = F.AutoFarm and F.FarmPos == "Bajo el suelo"
    if F.AutoHide and not farmSafe then
        local ref = Hide.origin and Hide.origin.Position or h.Position
        local _, d = G.nearestMonster(ref)
        local radius = Hide.target and F.DangerRadius * 1.15 or F.DangerRadius
        if d and d < radius then
            Hide.lastDanger = tick()
            hideStep()
            return
        end
        if Hide.target then
            if tick() - Hide.lastDanger < 1.5 then return end
            Hide.target = nil
            if Hide.origin and not F.AutoFarm then
                Move.go({ Hide.origin }, F.TweenSpeed * 1.4, "hide-return")
                Hide.returning = true
            end
            Hide.origin = nil
            return
        end
    elseif Hide.target then
        Hide.target, Hide.origin = nil, nil
        if Move.owner == "hide" then Move.stop(true) end
    end
    if Hide.returning then
        if Move.owner ~= "hide-return" or Move.arrived then
            Hide.returning = false
            if Move.owner == "hide-return" then Move.stop(false) end
        else
            return
        end
    end

    if F.AutoFarm then farmTick() return end
    if Move.owner == "farm" then Move.stop(true) farmReset() end

    if F.AutoDistract then
        if distractStep(dt) then return end
    end
    if Move.owner == "distract" or Move.owner == "hide" then Move.stop(true) end
end


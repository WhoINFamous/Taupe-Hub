    local h = getHRP()
    if not h then return end
    local best, bd
    for _, g in ipairs(Cache.gens) do
        if not G.genDone(g) then
            local p = posOf(g)
            if p then local d = (p - h.Position).Magnitude if not bd or d < bd then best, bd = g, d end end
        end
    end
    if best then
        local cf = workCF(best)
        if cf then
            local p = cf.Position
            if F.FarmPos == "Bajo el suelo" then p = p + Vector3.new(0, F.FarmDepth, 0) end
            teleportTo(p, true)
        end
    else notify("TP", "No hay máquinas pendientes.") end
end })

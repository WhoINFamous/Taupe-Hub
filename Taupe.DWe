    BackgroundColor3 = Theme.Side, BorderSizePixel = 0, Parent = Main,
})
create("Frame", { Size = UDim2.new(0, 1, 1, 0), Position = UDim2.new(1, -1, 0, 0), BackgroundColor3 = Theme.Stroke, BorderSizePixel = 0, Parent = Side })
